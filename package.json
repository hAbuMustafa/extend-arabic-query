{
  "name": "extend-arabic-query",
  "version": "0.3.1",
  "description": "Provides RegEx alternatives to fuzzy-compare against arabic text.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "ci": "npm run build && npm run check-format && npm run check-exports && npm run lint && npm run test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-exports": "attw --pack .",
    "lint": "tsc",
    "dev": "vitest",
    "test": "vitest run",
    "local-release": "changeset version && changeset publish",
    "prepuplishOnly": "npm run ci",
    "publish": "npm version patch --no-git-tag-version"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hAbuMustafa/extend-arabic-query.git"
  },
  "keywords": [
    "arabic",
    "search",
    "query",
    "extend",
    "replace",
    "fuzzy",
    "find",
    "match",
    "regex",
    "compare",
    "عربي",
    "عربى",
    "بحث",
    "توسيع",
    "معطيات"
  ],
  "author": "Hosam Hamdy AbuMustafa <hosam5553@gmail.com> (https://hosam.xyz)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hAbuMustafa/extend-arabic-query/issues"
  },
  "homepage": "https://github.com/hAbuMustafa/extend-arabic-query#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.4",
    "@changesets/cli": "^2.27.7",
    "concurrently": "^8.2.2",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "type": "module"
}
